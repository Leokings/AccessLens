{
  "name": "access-lens",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "eslint src vite.config.ts",
    "test:web": "vitest run",
    "contract:lint": "genvm-lint check contracts/access_lens.py --json",
    "contract:typecheck": "genvm-lint typecheck contracts/access_lens.py --json",
    "contract:test": "pytest tests/direct -q",
    "contract:sim": "python tests/run_glsim.py --port 4000 --validators 5 --no-browser",
    "contract:test:integration": "gltest tests/integration/test_access_lens_glsim.py -v -s --network localnet",
    "verify": "npm run contract:lint && npm run contract:typecheck && npm run contract:test && npm run lint && npm run test:web && npm run build"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.55.17"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.2.2",
    "vitest": "5.0.1"
  }
}
